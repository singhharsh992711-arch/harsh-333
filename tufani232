<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090909">
<title>REDDY444 | Sports Hub</title>
<style>
:root{--yellow:#ffd21a;--red:#bd1717;--bg:#101010;--panel:#202020;--muted:#a8a8a8}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:#fff;max-width:100%;overflow-x:hidden}
.top{background:#080808;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #333}
.brand{font-size:25px;font-weight:900;color:var(--yellow);letter-spacing:-1px}
.brand small{font-size:10px;color:#fff;display:block;letter-spacing:2px;margin-top:2px}
.top-right{text-align:right;font-size:12px;color:#ddd;line-height:1.6}
.top-right b{color:var(--yellow);font-size:15px}
.nav{display:flex;overflow-x:auto;background:#171717;border-bottom:1px solid #444;scrollbar-width:none}
.nav button{flex:1;min-width:82px;background:none;border:0;border-bottom:3px solid transparent;color:#eee;padding:15px 8px;font-weight:bold;font-size:12px}
.nav button.active{border-color:var(--yellow);color:var(--yellow)}
.ticker{white-space:nowrap;overflow:hidden;background:#080808;color:#ddd;padding:10px;font-size:12px}
.ticker span{display:inline-block;padding-left:100%;animation:scroll 22s linear infinite}
@keyframes scroll{to{transform:translateX(-100%)}}
.hero{background:var(--red);text-align:center;padding:15px;font-weight:900;letter-spacing:1px}
.categories{display:flex;gap:7px;overflow-x:auto;background:#191919;padding:12px 8px;scrollbar-width:none}
.cat{min-width:78px;text-align:center;background:#292929;padding:10px 5px;border-radius:4px;font-size:11px;font-weight:bold}
.cat i{display:block;font-style:normal;font-size:25px;margin-bottom:6px}
.pills{display:flex;gap:7px;padding:12px 10px;background:#111;overflow:auto}
.pill{border:1px solid #555;border-radius:20px;padding:7px 13px;font-size:11px;white-space:nowrap;color:#ddd}
.pill.selected{background:var(--yellow);color:#111;border-color:var(--yellow);font-weight:bold}
.section-title{padding:13px 12px;background:#292929;border-left:4px solid var(--yellow);font-size:14px;font-weight:900;display:flex;justify-content:space-between}
.section-title small{font-size:10px;color:#aaa;font-weight:normal}
.page{display:none}.page.active{display:block}
.match{margin:5px 0;background:#eee;color:#111;padding:13px 12px}
.league{font-size:11px;color:#666;margin-bottom:10px}
.match-head{display:flex;justify-content:space-between;gap:8px;align-items:center;font-size:13px;font-weight:bold}
.match-head .state{color:#178a42;font-size:10px}
.teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;text-align:center;background:#ddd;margin-top:12px;padding:12px 7px;font-weight:bold}
.teams span:first-child{text-align:left}.teams span:last-child{text-align:right}
.match-foot{font-size:10px;color:#555;margin-top:9px;display:flex;justify-content:space-between}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;padding:10px}
.tile{min-height:105px;background:linear-gradient(145deg,#383838,#171717);border:1px solid #444;border-radius:5px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:13px;font-weight:bold}
.tile strong{display:block;font-size:27px;margin-bottom:8px}
.news{background:#242424;margin:6px 10px;padding:14px;border-radius:4px;font-size:13px;line-height:1.5}
.notice{padding:13px;margin:10px;background:#242424;border:1px solid #484848;border-radius:5px;color:#ccc;font-size:12px;line-height:1.5}
footer{text-align:center;background:#080808;padding:22px 12px;color:#aaa;font-size:11px;line-height:1.8;margin-top:12px}
footer b{color:var(--yellow);font-size:20px}
button{cursor:pointer}
@media(min-width:700px){body{max-width:480px;margin:auto;border-left:1px solid #333;border-right:1px solid #333;min-height:100vh}.nav button{min-width:0}}
</style>
</head>
<body>
<header class="top">
  <div class="brand">🏠 REDDY444<small>SPORTS INFORMATION HUB</small></div>
  <div class="top-right"><b>SPORTS 2026</b><br>Welcome, Guest</div>
</header>
<nav class="nav" aria-label="Main navigation">
  <button class="active" data-page="home">HOME</button>
  <button data-page="cricket">CRICKET</button>
  <button data-page="football">FOOTBALL</button>
  <button data-page="tennis">TENNIS</button>
  <button data-page="news">SPORTS NEWS</button>
</nav>
<div class="ticker"><span>🏆 SPORTS HUB &nbsp; • &nbsp; Cricket &nbsp; • &nbsp; Football &nbsp; • &nbsp; Tennis &nbsp; • &nbsp; Match schedules and sports updates</span></div>
<div class="hero">🏆 SPORTS WORLD 2026 🏆</div>
<div class="categories">
  <div class="cat"><i>🏏</i>CRICKET</div><div class="cat"><i>⚽</i>FOOTBALL</div>
  <div class="cat"><i>🎾</i>TENNIS</div><div class="cat"><i>🏆</i>TOURNAMENTS</div>
  <div class="cat"><i>🏀</i>BASKETBALL</div><div class="cat"><i>📰</i>NEWS</div>
</div>
<div class="pills"><span class="pill selected">• LIVE INFO</span><span class="pill">UPCOMING</span><span class="pill">RESULTS</span><span class="pill">SCHEDULE</span></div>

<main>
<section id="home" class="page active">
  <div class="section-title">🏏 FEATURED MATCHES <small>DEMO SCHEDULE</small></div>
  <article class="match"><div class="league">CRICKET • EXAMPLE FIXTURE</div><div class="match-head"><span>Indian Premier League</span><span class="state">● SCHEDULE</span></div><div class="teams"><span>RCB</span><b>VS</b><span>GT</span></div><div class="match-foot"><span>Fixture preview</span><span>Time not connected</span></div></article>
  <article class="match"><div class="league">CRICKET • EXAMPLE FIXTURE</div><div class="match-head"><span>International Cricket</span><span class="state">● SCHEDULE</span></div><div class="teams"><span>INDIA</span><b>VS</b><span>AUSTRALIA</span></div><div class="match-foot"><span>Fixture preview</span><span>Time not connected</span></div></article>
  <div class="section-title">🎮 SPORTS CATEGORIES</div>
  <div class="grid">
    <div class="tile"><div><strong>🏏</strong>CRICKET</div></div><div class="tile"><div><strong>⚽</strong>FOOTBALL</div></div>
    <div class="tile"><div><strong>🎾</strong>TENNIS</div></div><div class="tile"><div><strong>🏀</strong>BASKETBALL</div></div>
    <div class="tile"><div><strong>🏆</strong>TOURNAMENTS</div></div><div class="tile"><div><strong>📰</strong>SPORTS NEWS</div></div>
  </div>
  <div class="notice">Note: This is a sports-information demo. Match names shown above are sample content, not verified fixtures or live scores.</div>
</section>

<section id="cricket" class="page">
  <div class="section-title">🏏 CRICKET CENTER</div>
  <article class="match"><div class="league">CRICKET</div><div class="match-head"><span>Indian Premier League</span><span class="state">SCHEDULE</span></div><div class="teams"><span>RCB</span><b>VS</b><span>GT</span></div></article>
  <article class="match"><div class="league">INTERNATIONAL</div><div class="match-head"><span>International Cricket</span><span class="state">UPDATES</span></div><div class="teams"><span>INDIA</span><b>VS</b><span>AUSTRALIA</span></div></article>
  <div class="notice">Live score data has not been connected yet. Add a licensed sports-data API key to display verified live scores.</div>
</section>

<section id="football" class="page">
  <div class="section-title">⚽ FOOTBALL CENTER</div>
  <article class="match"><div class="league">FOOTBALL</div><div class="match-head"><span>Premier League</span><span class="state">UPDATES</span></div><div class="teams"><span>TEAM A</span><b>VS</b><span>TEAM B</span></div></article>
  <article class="match"><div class="league">FOOTBALL</div><div class="match-head"><span>Champions League</span><span class="state">UPDATES</span></div><div class="teams"><span>TEAM A</span><b>VS</b><span>TEAM B</span></div></article>
</section>

<section id="tennis" class="page">
  <div class="section-title">🎾 TENNIS CENTER</div>
  <article class="match"><div class="league">TENNIS</div><div class="match-head"><span>Wimbledon</span><span class="state">TOURNAMENT</span></div></article>
  <article class="match"><div class="league">TENNIS</div><div class="match-head"><span>Australian Open</span><span class="state">TOURNAMENT</span></div></article>
  <article class="match"><div class="league">TENNIS</div><div class="match-head"><span>French Open</span><span class="state">TOURNAMENT</span></div></article>
</section>

<section id="news" class="page">
  <div class="section-title">📰 SPORTS NEWS</div>
  <div class="news">🏏 Cricket updates and tournament coverage</div>
  <div class="news">⚽ Football updates and league coverage</div>
  <div class="news">🎾 Tennis tournament coverage</div>
  <div class="notice">News headlines are placeholders. Connect a trusted news source to publish current headlines.</div>
</section>
</main>
<footer><b>REDDY444</b><br>Sports Information Website<br>© 2026 All Rights Reserved</footer>
<script>
document.querySelectorAll('.nav button').forEach(button=>{
  button.addEventListener('click',()=>{
    document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    button.classList.add('active');
    document.getElementById(button.dataset.page).classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
  });
});
</script>
</body>
</html>
